\Topic{Polymerization}
\From{Applied Chemistry–II, Unit: Polymers}
\Level{Diploma}
\Question{Define polymerization with example.}
\Explain{Monomers join to form polymer; e.g., ethene → polyethylene.}
\Answer{Polyethylene formation}
\Formula{$nCH_{2}=CH_{2}\rightarrow(CH_{2}-CH_{2})_{n}$.}

\item
\Topic{Corrosion Prevention}
\From{Applied Chemistry–II, Unit: Corrosion}
\Level{Diploma}
\Question{Name two methods to prevent corrosion.}
\Explain{Painting/coating and cathodic protection.}
\Answer{Painting, cathodic protection}
\Formula{Protective methods.}

\item
\Topic{Viscosity}
\From{Applied Chemistry–II, Unit: Lubricants}
\Level{Diploma}
\Question{Define viscosity.}
\Explain{$\eta=\tau/(du/dy)$, internal resistance to flow.}
\Answer{$\eta=\tau/(du/dy)$}
\Formula{Viscosity definition.}

\item
\Topic{Moment of Force}
\From{Engineering Mechanics, Unit: Statics}
\Level{Diploma}
\Question{Define moment of a force.}
\Explain{$M=Fd$, turning effect about a point.}
\Answer{$M=Fd$}
\Formula{$M=\vec r\times\vec F$.}

\item
\Topic{Equilibrium}
\From{Engineering Mechanics, Unit: Statics}
\Level{Diploma}
\Question{State equilibrium conditions for coplanar forces.}
\Explain{$\sum F_x=0,\ \sum F_y=0,\ \sum M=0$.}
\Answer{These three sums zero}
\Formula{Statics equilibrium conditions.}

\item
\Topic{Centre of Gravity}
\From{Engineering Mechanics, Unit: Centroid}
\Level{Diploma}
\Question{Define centre of gravity.}
\Explain{Point where whole weight acts; for uniform body equals geometry centre.}
\Answer{Point through which weight acts}
\Formula{$\bar x=\dfrac{\sum x_iA_i}{\sum A_i}$.}

\item
\Topic{Mechanical Advantage}
\From{Engineering Mechanics, Unit: Simple Machines}
\Level{Diploma}
\Question{Define mechanical advantage.}
\Explain{$MA=\dfrac{\text{Load}}{\text{Effort}}$.}
\Answer{$MA=W/P$}
\Formula{$MA=\dfrac{\text{Load}}{\text{Effort}}$.}

\item
\Topic{Velocity Ratio of Pulleys}
\From{Engineering Mechanics, Unit: Simple Machines}
\Level{Diploma}
\Question{Show that velocity ratio equals number of supporting ropes in ideal pulley.}
\Explain{In ideal system distance by effort = n × distance of load ⇒ VR = n.}
\Answer{$VR=n$}
\Formula{Velocity ratio relation.}

