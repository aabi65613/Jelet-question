\Topic{Matrix – Orthogonal Matrices}
\From{Diploma Mathematics--II, Unit: Determinants & Matrices}
\Level{12th / Diploma}
\Question{If $A$ and $B$ are orthogonal matrices and $\det(A)+\det(B)=0$, prove that $A+B$ is singular.}
\Explain{Orthogonal matrices have determinant $\pm1$. The condition forces one determinant $+1$ and the other $-1$. Consider $B^{-1}A$; its determinant is $\det(A)/\det(B)=-1$. An orthogonal matrix with determinant $-1$ has eigenvalue $-1$, so $\exists x\neq0$ with $B^{-1}Ax=-x$. Multiply by $B$ to get $Ax=-Bx$, hence $(A+B)x=0$ for nonzero $x$. So $A+B$ is singular.}
\Answer{$A+B$ is singular.}
\Formula{$\det(AB)=\det(A)\det(B)$; orthogonal: $A^{T}A=I$.}

